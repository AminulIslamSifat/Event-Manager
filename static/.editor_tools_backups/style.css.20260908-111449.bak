* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; background: #0f0f0f; color: #e0e0e0; }
nav { display: flex; justify-content: space-between; align-items: center; padding: 1rem 2rem; background: #1a1a1a; border-bottom: 1px solid #2a2a2a; }
nav h1 { cursor: pointer; font-size: 1.3rem; color: #7c5cfc; }
#nav-links { display: flex; gap: 1rem; }
#nav-links button { background: none; border: 1px solid #333; color: #ccc; padding: 0.4rem 1rem; border-radius: 6px; cursor: pointer; }
#nav-links button:hover { border-color: #7c5cfc; color: #fff; }
main { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
.card { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 10px; padding: 1.5rem; margin-bottom: 1rem; }
.card h2 { margin-bottom: 0.5rem; color: #fff; }
.card p { color: #999; margin-bottom: 0.3rem; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
input, select, textarea { width: 100%; padding: 0.6rem; margin-bottom: 0.8rem; background: #111; border: 1px solid #333; color: #e0e0e0; border-radius: 6px; }
button.primary { background: #7c5cfc; color: #fff; border: none; padding: 0.6rem 1.5rem; border-radius: 6px; cursor: pointer; font-weight: 600; }
button.primary:hover { background: #6a4ae0; }
button.danger { background: #c0392b; color: #fff; border: none; padding: 0.4rem 1rem; border-radius: 6px; cursor: pointer; }
.form-group { max-width: 450px; margin: 0 auto; }
.tag { display: inline-block; background: #7c5cfc22; color: #7c5cfc; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.8rem; margin-right: 0.5rem; }
.meta { display: flex; gap: 1rem; margin: 0.5rem 0; font-size: 0.9rem; }
.error { color: #e74c3c; margin-bottom: 0.5rem; font-size: 0.9rem; }
.back-btn { background: none; border: none; color: #7c5cfc; cursor: pointer; margin-bottom: 1rem; font-size: 0.95rem; }
